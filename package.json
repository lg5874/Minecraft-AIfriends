{
  "name": "minecraft-aifriend",
  "version": "0.1.0",
  "description": "给 Minecraft 服务器装一个真的在玩的 AI 玩家",
  "private": true,
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "check": "node scripts/check-syntax.js",
    "test:memory": "node scripts/test-memory.js",
    "test:decay": "node scripts/test-decay.js",
    "test:persona": "node scripts/test-persona.js",
    "test": "node scripts/test-memory.js && node scripts/test-decay.js && node scripts/test-persona.js && node scripts/test-perceive.js",
    "test:perceive": "node scripts/test-perceive.js",
    "test:fake-success": "node scripts/test-fake-success.js",
    "scan:fake": "node scripts/scan-fake-success.js",
    "test:actionlock": "node scripts/test-actionlock.js",
    "test:cost": "node scripts/test-cost.js",
    "test:lie-audit": "node scripts/lie-audit.js --self-check",
    "test:skills": "node scripts/test-skills.js",
    "test:goals": "node scripts/test-goals.js",
    "blind": "node scripts/blind-test.js",
    "check:judge": "node scripts/check-judge-discipline.js",
    "audit:ledger": "node scripts/audit-skill-ledger.js"
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "llm",
    "agent",
    "paper"
  ],
  "license": "MIT",
  "dependencies": {
    "minecraft-data": "^3.119.0",
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "2.4.5",
    "vec3": "^0.1.10"
  }
}
