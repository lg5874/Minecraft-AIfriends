# 依赖
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# 运行时数据（记忆、品味、心情、技能库、生成的代码、日志）
data/runtime/
data/runtime-*/
data/memory/
data/test-results/
logs/
*.log

# 配置里带 API key，不要提交
config.json
config.local.json
config.test.json
config.*.json
!config.example.json

# 构建产物
dist/
build/
*.jar

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# 临时
tmp/
.cache/
*.bak
*.bak-*
*.orig
*.rej
*.tmp.js

# 探针和测试临时产物（成员跑测试时生成的，不该入库）
.tmp-*
data/probe-*/
data/probe*.json
data/tmp-*/
# 探针用的独立数据目录（XJJ_XXX 之类的测试账号）
data/XJJ_*/
# 编辑器的备份副本，不该入库
*.orig.js
*.bak.js
